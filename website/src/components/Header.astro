---
import { langOf, switchTarget, ui } from '../i18n';

const lang = langOf(Astro.url.pathname);
const t = ui[lang];
const otherLang = lang === 'fr' ? 'en' : 'fr';
// The company pages are commercial; the docs link only shows on the Atmosphere product page.
const onAtmosphere = Astro.url.pathname.startsWith('/atmosphere/');

const navLinks = [
  { href: '/atmosphere/', label: 'Atmosphere' },
  { href: 'https://mirroir.dev', label: 'mirroir' },
  { href: `${t.home}#consulting`, label: t.nav.services },
  { href: '/atmosphere/#support', label: t.nav.support },
  ...(onAtmosphere ? [{ href: '/docs/', label: t.nav.docs }] : []),
  { href: '/blog/', label: t.nav.blog },
  { href: t.contact, label: t.nav.cta, cta: true },
];
---

<header class="header" id="siteHeader">
  <div class="header-inner">
    <a href={t.home} class="logo">
      <img src="/logo.svg" alt="Async IO" class="logo-img" width="40" height="40" />
      <span class="logo-text">Async IO</span>
    </a>

    <nav class="nav" id="mainNav" aria-label={t.nav.main}>
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={['nav-link', { 'nav-cta': link.cta }]}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href={switchTarget(Astro.url.pathname)}
            class="nav-link lang-switch"
            hreflang={otherLang}
            lang={otherLang}
            aria-label={t.nav.switchAria}
          >
            {t.nav.switchLabel}
          </a>
        </li>
      </ul>
    </nav>

    <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label={t.nav.menu} aria-expanded="false" aria-controls="mainNav">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobileMenuBtn');
    const nav = document.getElementById('mainNav');
    const header = document.getElementById('siteHeader');
    if (!btn || !nav || !header) return;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      nav.classList.toggle('nav-open');
      header.classList.toggle('menu-open');
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    // Close menu when a nav link is clicked
    nav.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        nav.classList.remove('nav-open');
        header.classList.remove('menu-open');
        document.body.style.overflow = '';
      });
    });
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--space-md) var(--space-xl);
  }

  /* The blur sits on a pseudo-element: backdrop-filter on .header itself would make it the
     containing block of the fixed mobile nav and clip the open menu to the header's height. */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--color-bg-primary) 0%, transparent 100%);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background 0.3s ease;
  }

  .header.menu-open::before {
    background: var(--color-bg-primary);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-text-primary);
    transition: color 0.2s var(--ease-out-quad);
    z-index: 2;
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .logo-img {
    border-radius: 6px;
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: -0.01em;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    list-style: none;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: color 0.2s var(--ease-out-quad);
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-cta {
    padding: var(--space-sm) var(--space-md);
    color: var(--color-bg-primary);
    background: var(--color-text-primary);
    border-radius: 8px;
    transition: background 0.2s var(--ease-out-quad);
  }

  .nav-cta:hover {
    color: var(--color-bg-primary);
    background: var(--color-accent);
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    padding: 2px 6px;
    border: 1px solid var(--color-border-accent);
    border-radius: 4px;
  }


  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 7px;
    padding: var(--space-sm);
    background: none;
    border: none;
    cursor: pointer;
    z-index: 2;
  }

  .hamburger-line {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text-primary);
    transition: all 0.3s var(--ease-out-expo);
    transform-origin: center;
  }

  /* Hamburger → X animation */
  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .mobile-menu-btn[aria-expanded="true"] .hamburger-line:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .header {
      padding: var(--space-md);
    }

    .nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      background: var(--color-bg-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s var(--ease-out-expo);
    }

    .nav.nav-open {
      opacity: 1;
      pointer-events: auto;
    }

    .nav {
      overflow-y: auto;
      padding: 5rem 0 var(--space-xl);
    }

    .nav-list {
      flex-direction: column;
      gap: var(--space-lg);
      margin: auto 0;
    }

    .nav-link {
      font-size: 1.5rem;
      font-family: var(--font-display);
      font-weight: 400;
      color: var(--color-text-primary);
    }

    .nav-cta {
      color: var(--color-bg-primary);
      padding: var(--space-sm) var(--space-xl);
    }

    .lang-switch {
      font-family: var(--font-mono);
      font-size: 0.875rem;
      padding: var(--space-xs) var(--space-sm);
    }

    .mobile-menu-btn {
      display: flex;
    }
  }
</style>
