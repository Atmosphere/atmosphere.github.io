---
---

<section class="hero">
  <div class="hero-bg">
    <div class="grid-lines"></div>
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <div class="hero-content">
    <!-- Proof is verifiable open-source fact, rounded down. Re-check before editing:
         stars:    gh api repos/Atmosphere/atmosphere --jq .stargazers_count            (3,821 on 2026-10-14)
         releases: curl -s https://repo1.maven.org/maven2/org/atmosphere/atmosphere-runtime/maven-metadata.xml
                   | grep -o '<version>[^<]*' | grep -viE 'rc|beta|alpha|snapshot|m[0-9]' | wc -l   (283 on 2026-10-14) -->
    <ul class="hero-proof">
      <li>
        <a href="https://github.com/Atmosphere/atmosphere" target="_blank" rel="noopener noreferrer">
          &#9733; 3.8K GitHub stars
        </a>
      </li>
      <li>280+ releases on Maven Central</li>
      <li>Supported since 2013</li>
    </ul>

    <h1 class="hero-title">
      Real-time AI agents for the JVM,
      <span class="title-accent">backed by the team that builds them.</span>
    </h1>

    <p class="hero-description">
      <strong>Async IO</strong> builds Atmosphere, the open-source framework that streams one
      <code>@Agent</code> to browsers and apps over WebSocket, SSE or WebTransport, on any of
      twelve AI runtimes. We keep it running in production for the teams that depend on it.
    </p>
    <div class="hero-actions">
      <a href="/contact/" class="btn btn-primary">
        Talk to us
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="/docs/tutorial/02-getting-started/" class="btn btn-secondary">
        Get started free
      </a>
    </div>
    <div class="hero-stats">
      <div class="stat">
        <span class="stat-value">5 Transports</span>
        <span class="stat-label">WebSocket, SSE, HTTP Streaming, Long-Polling, WebTransport/HTTP3</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">3 Agent Protocols</span>
        <span class="stat-label">MCP, A2A, AG-UI</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat">
        <span class="stat-value">12 AI Runtimes</span>
        <span class="stat-label">one SPI &mdash; swap by dependency, keep your code</span>
      </div>
    </div>

    <!-- Captured 2026-10-15 from samples/spring-boot-multi-agent-startup-team (4.0.74-SNAPSHOT)
         with Koog on a local Ollama qwen2.5:7b-instruct-q4_K_M and a self-hosted SearXNG behind
         web_search; the plan verdict, search results and agent cards are what that run produced. -->
    <figure class="hero-shot">
      <img
        src="/console-team.webp"
        width="1280"
        height="860"
        loading="lazy"
        decoding="async"
        alt="The Atmosphere AI Console over WebTransport: a market-analysis prompt, the coordinator's verified seven-step plan, and the research agent's live web search results before the strategy agent starts."
      />
      <figcaption>A coordinator verifying its plan, then fanning the question out to its research, strategy, finance and writer agents.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4xl) var(--space-xl);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.3;
    mask-image: radial-gradient(ellipse 80% 50% at 50% 50%, black 20%, transparent 100%);
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.4;
  }

  .glow-1 {
    top: 10%;
    left: 20%;
    width: 400px;
    height: 400px;
    background: var(--color-accent);
    opacity: 0.15;
    animation: float 8s ease-in-out infinite;
  }

  .glow-2 {
    bottom: 20%;
    right: 15%;
    width: 300px;
    height: 300px;
    background: #6366f1;
    opacity: 0.1;
    animation: float 10s ease-in-out infinite reverse;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, -30px); }
  }

  .hero-content {
    position: relative;
    min-width: 0;
    max-width: 960px;
    text-align: center;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-lg);
    text-wrap: balance;
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.1s both;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    list-style: none;
    margin-bottom: var(--space-xl);
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.05s both;
  }

  .hero-proof li {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border-accent);
    border-radius: 999px;
    padding: 0.35em 0.9em;
  }

  .hero-proof a {
    color: inherit;
    transition: color 0.2s var(--ease-out-quad);
  }

  .hero-proof a:hover {
    color: var(--color-accent);
  }

  .title-accent {
    display: block;
    background: linear-gradient(135deg, #b8944a, #d4b060, #c4a86a);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    font-style: italic;
  }

  .hero-description {
    max-width: 600px;
    margin: 0 auto var(--space-2xl);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.3s both;
  }

  .hero-description strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .hero-description code {
    font-family: var(--font-mono);
    font-size: 0.95em;
    color: var(--color-text-primary);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.4s both;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-xl);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: 8px;
    transition: all 0.2s var(--ease-out-quad);
    cursor: pointer;
    border: none;
  }

  .btn-primary {
    background: var(--color-text-primary);
    color: var(--color-bg-primary);
  }

  .btn-primary:hover {
    background: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--color-accent-glow);
  }

  .btn-secondary {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-accent);
  }

  .btn-secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-bg-elevated);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.5s both;
  }

  .stat {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
    white-space: nowrap;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--color-border-accent);
  }

  .hero-shot {
    margin: var(--space-3xl) auto 0;
    max-width: 960px;
    animation: fadeInUp 0.8s var(--ease-out-expo) 0.6s both;
  }

  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border-accent);
    border-radius: 12px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5), 0 0 60px var(--color-accent-glow);
  }

  .hero-shot figcaption {
    margin-top: var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-4xl) var(--space-md);
    }

    .hero-proof li {
      font-size: 0.6875rem;
      letter-spacing: 0;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
      justify-content: center;
    }

    .hero-stats {
      flex-direction: column;
      gap: var(--space-lg);
    }

    .stat-divider {
      width: 40px;
      height: 1px;
    }
  }
</style>
