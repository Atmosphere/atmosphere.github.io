---
import { ui, type Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
---

<section class="co-hero">
  <div class="co-hero-bg" aria-hidden="true">
    <div class="grid-lines"></div>
    <div class="glow"></div>
  </div>

  <div class="co-hero-content">
    <h1 class="co-hero-title">{t.hero.title}</h1>
    <p class="co-hero-description">
      {t.hero.lines.map((l) => <span>{l}</span>)}
    </p>
    <div class="co-hero-actions">
      <a href={`${t.contact}?plan=Consulting`} class="co-btn co-btn-primary">{t.hero.contact}</a>
      <a href="#consulting" class="co-btn co-btn-secondary">{t.hero.services}</a>
    </div>
  </div>
</section>

<style>
  .co-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--space-4xl) + 2rem) var(--space-xl) var(--space-2xl);
    overflow: hidden;
  }

  .co-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* The hero now ends close to its buttons: fade the glow out instead of cutting it off. */
    mask-image: linear-gradient(to bottom, black 55%, transparent 100%);
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.3;
    mask-image: radial-gradient(ellipse 80% 50% at 50% 50%, black 20%, transparent 100%);
  }

  .glow {
    position: absolute;
    top: 15%;
    left: 30%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(100px);
    background: var(--color-accent);
    opacity: 0.12;
  }

  .co-hero-content {
    position: relative;
    max-width: 900px;
    text-align: center;
  }

  .co-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-lg);
    text-wrap: balance;
  }

  .co-hero-description {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-2xl);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .co-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
  }

  @media (max-width: 768px) {
    .co-hero {
      padding: calc(var(--space-4xl) + 1rem) var(--space-md) var(--space-xl);
    }
  }
</style>
