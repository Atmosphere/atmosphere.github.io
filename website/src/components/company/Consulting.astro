---
// Technical due diligence and R&D tax credits are drawn from the maintainer's profile
// (acquisitions; tax-credit and funding applications as founding engineer).
import { ui, type Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
const groups = t.services.groups;
---

<section class="co-section" id="consulting">
  <div class="co-container">
    <h2 class="co-title">{t.services.title}</h2>
    <div class="groups">
      {groups.map((g) => (
        <div class="group">
          <h3 class="group-title">{g.title}</h3>
          <ul>
            {g.items.map((i) => <li>{i}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .co-title {
    margin-bottom: var(--space-2xl);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .group {
    border-top: 1px solid var(--color-accent);
    padding-top: var(--space-md);
  }

  .group-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .group ul {
    list-style: none;
    display: grid;
    gap: var(--space-sm);
  }

  .group li {
    color: var(--color-text-primary);
  }

  @media (max-width: 860px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
