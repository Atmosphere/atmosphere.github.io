---
// Sources: Atmosphere = the /atmosphere/ page; mirroir = github.com/jfarcand/mirroir-mcp README;
// TrailSnag = trailsnag.com landing copy. Atmosphere and mirroir are Apache 2.0; TrailSnag is not open source.
import { ui, type Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
// Product marks, redrawn in currentColor so they read on the dark card in any system theme.
// Sources: docs/src/assets/logo.svg (Atmosphere), mirroir-mcp website/public/favicon.svg,
// trailsnag.github.io public/favicon.svg.
const icons = {
  atmosphere:
    '<svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2"/><path d="M12 20 C12 14, 20 10, 20 10 S28 14, 28 20 S20 30, 20 30 S12 26, 12 20Z" fill="currentColor" opacity="0.15"/><circle cx="20" cy="20" r="4" fill="currentColor"/></svg>',
  mirroir:
    '<svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="8" y="4" width="16" height="24" rx="3" stroke="currentColor" stroke-width="2"/><line x1="14" y1="25" x2="18" y2="25" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
  trailsnag:
    '<svg viewBox="0 0 64 80" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d="M32 77C32 77 6 46.5 6 29 6 14.6 17.6 3 32 3c14.4 0 26 11.6 26 26 0 17.5-26 48-26 48Z M28.16 13.28 33.14 12.84 A3.5 3.5 0 0 1 36.93 16.02 L39.02 39.93 A3.5 3.5 0 0 1 35.84 43.72 L30.86 44.16 A3.5 3.5 0 0 1 27.07 40.98 L24.98 17.07 A3.5 3.5 0 0 1 28.16 13.28 Z"/></svg>',
};

const products = [
  {
    name: 'Atmosphere',
    href: '/atmosphere/',
    icon: icons.atmosphere,
    media: { kind: 'image', src: '/console-team.webp', alt: t.products.atmosphereAlt },
    meta: t.products.atmosphereMeta,
    tagline: t.products.atmosphere,
    links: [
      { href: '/atmosphere/', label: t.products.learnMore },
      { href: '/atmosphere/#support', label: t.products.support },
      { href: 'https://github.com/Atmosphere/atmosphere', label: 'GitHub', external: true },
    ],
  },
  {
    name: 'mirroir',
    href: 'https://mirroir.dev',
    icon: icons.mirroir,
    media: {
      kind: 'video',
      src: '/media/mirroir-recipe.mp4',
      poster: '/media/mirroir-recipe.poster.jpg',
      alt: t.products.mirroirAlt,
    },
    tagline: t.products.mirroir,
    links: [
      { href: 'https://mirroir.dev', label: 'mirroir.dev', external: true },
      { href: 'https://github.com/jfarcand/mirroir-mcp', label: 'GitHub', external: true },
    ],
  },
  {
    name: 'TrailSnag',
    href: 'https://trailsnag.com',
    icon: icons.trailsnag,
    // Screens from trailsnag.com's own capture set (demo organisation), in the page's language.
    media: {
      kind: 'video',
      src: `/media/trailsnag.${lang}.mp4`,
      poster: `/media/trailsnag.${lang}.poster.jpg`,
      alt: t.products.trailsnagAlt,
    },
    tagline: t.products.trailsnag,
    links: [{ href: 'https://trailsnag.com', label: 'trailsnag.com', external: true }],
  },
];
---

<section class="co-section alt" id="products">
  <div class="co-container">
    <h2 class="co-title">{t.products.title}</h2>
    <div class="products-grid">
      {products.map((p) => (
        <article class="co-card product">
          <a href={p.href} class="product-media" tabindex="-1">
            {p.media.kind === 'image' ? (
              <img src={p.media.src} alt={p.media.alt} loading="lazy" decoding="async" width="1280" height="800" />
            ) : (
              <video
                src={p.media.src}
                poster={p.media.poster}
                aria-label={p.media.alt}
                muted
                loop
                playsinline
                preload="none"
                width="1280"
                height="800"
              ></video>
            )}
          </a>
          <h3 class="product-name">
            <span class="product-icon" set:html={p.icon} />
            <a href={p.href}>{p.name}</a>
          </h3>
          {p.meta && <span class="product-meta">{p.meta}</span>}
          <p class="product-tagline">{p.tagline}</p>
          <div class="product-links">
            {p.links.map((l) => (
              <a
                href={l.href}
                class="co-link"
                {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {l.label}
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  // Play each demo only while it is on screen; leave the poster for reduced-motion visitors.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('.product-media video');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            v.play().catch(() => {
              // Autoplay refused (power saving, browser policy): the poster stays visible.
            });
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.3 }
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .co-title {
    margin-bottom: var(--space-2xl);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .product {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .product-name {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
  }

  .product-media {
    display: block;
    aspect-ratio: 16 / 10;
    margin: calc(-1 * var(--space-sm)) calc(-1 * var(--space-sm)) var(--space-xs);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-bg-primary);
  }

  .product-media img,
  .product-media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .product-name {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .product-icon {
    display: inline-flex;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-accent);
  }

  .product-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .product-name a {
    transition: color 0.2s var(--ease-out-quad);
  }

  .product-name a:hover {
    color: var(--color-accent);
  }

  .product-meta {
    margin-top: calc(-1 * var(--space-sm));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .product-tagline {
    color: var(--color-text-secondary);
    flex: 1;
  }

  .product-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
  }

  @media (max-width: 860px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
