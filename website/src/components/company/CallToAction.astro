---
import { ui, type Lang } from '../../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = ui[lang];
---

<section class="co-section alt" id="contact">
  <div class="co-container cta">
    <h2 class="co-title">{t.cta.title}</h2>
    <div class="cta-actions">
      <a href={`${t.contact}?plan=Consulting`} class="co-btn co-btn-primary">{t.cta.book}</a>
      <a class="co-link" href="mailto:support@async-io.org">support@async-io.org</a>
    </div>
  </div>
</section>

<style>
  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .cta .co-title {
    margin-bottom: 0;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }
</style>
