---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CompanyHero from '../components/company/CompanyHero.astro';
import Products from '../components/company/Products.astro';
import Consulting from '../components/company/Consulting.astro';
import Work from '../components/company/Work.astro';
import CallToAction from '../components/company/CallToAction.astro';
import '../styles/company.css';
import { ui } from '../i18n';

// Section anchors that lived on this URL before the Atmosphere page moved to /atmosphere/.
// Links already published (README, docs, posts) point at e.g. https://async-io.live/#support.
// The platform sections later moved again, from /atmosphere/ to /atmosphere/platform/.
const movedAnchors: Record<string, string> = {
  support: '/atmosphere/#support',
  capabilities: '/atmosphere/#capabilities',
  shipped: '/atmosphere/platform/#shipped',
  atmosphere: '/atmosphere/platform/#atmosphere',
  why: '/atmosphere/platform/#why',
};
---

<Layout title={ui.en.meta.title} description={ui.en.meta.description}>
  <script is:inline define:vars={{ movedAnchors }}>
    // Keep old deep links working: /#support now lives at /atmosphere/#support.
    (function () {
      var id = window.location.hash.slice(1);
      if (Object.prototype.hasOwnProperty.call(movedAnchors, id)) {
        window.location.replace(movedAnchors[id]);
      }
    })();
  </script>
  <Header />
  <main>
    <CompanyHero />
    <Consulting />
    <Products />
    <Work />
    <CallToAction />
  </main>
  <Footer />
</Layout>
