---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Highlights from '../../components/Highlights.astro';
import CodeExample from '../../components/CodeExample.astro';
import Support from '../../components/Support.astro';
import Footer from '../../components/Footer.astro';

// Sections that moved to /atmosphere/platform/ when this page was shortened.
const movedToPlatform = ['shipped', 'atmosphere', 'why'];
---

<Layout title="Atmosphere — Real-time AI agents for the JVM | Async IO">
  <script is:inline define:vars={{ movedToPlatform }}>
    // Keep deep links working: /atmosphere/#why now lives at /atmosphere/platform/#why.
    (function () {
      var id = window.location.hash.slice(1);
      if (movedToPlatform.indexOf(id) !== -1) {
        window.location.replace('/atmosphere/platform/#' + id);
      }
    })();
  </script>
  <Header />
  <main>
    <Hero />
    <Highlights />
    <CodeExample />
    <Support />
  </main>
  <Footer />
</Layout>
